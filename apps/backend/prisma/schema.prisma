  discountMetadata Json?
  terms            String?
  notes            String?
  issuedAt         DateTime?
  paidAt           DateTime?
  overdueAt        DateTime?
  cancelledAt      DateTime?
  writtenOffAt     DateTime?
  cancelReason     String?
  writeOffReason   String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?
  createdById      String?             @db.Uuid
  updatedById      String?             @db.Uuid
  company          Company             @relation(fields: [companyId], references: [id])
  client           Client              @relation(fields: [clientId], references: [id])
  project          Project?            @relation(fields: [projectId], references: [id])
  opportunity      SalesOpportunity?   @relation(fields: [opportunityId], references: [id])
  quotation        Quotation?          @relation(fields: [quotationId], references: [id])
  series           InvoiceSeries?      @relation(fields: [seriesId], references: [id])
  items            InvoiceItem[]
  allocations      ReceiptAllocation[]
  creditNotes      CreditNote[]
  debitNotes       DebitNote[]
  salesLead        SalesLead?          @relation(fields: [salesLeadId], references: [id])
  salesLeadId      String?             @db.Uuid

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([clientId])
  @@index([projectId])
  @@index([opportunityId])
  @@index([quotationId])
  @@index([seriesId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
}

model InvoiceItem {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @db.Uuid
  invoiceId        String    @db.Uuid
  description      String
  quantity         Decimal   @default(1) @db.Decimal(12, 2)
  unitPrice        Decimal   @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal   @default(0) @db.Decimal(12, 2)
  taxAmount        Decimal   @default(0) @db.Decimal(12, 2)
  lineTotal        Decimal   @default(0) @db.Decimal(12, 2)
  taxMetadata      Json?
  discountMetadata Json?
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  createdById      String?   @db.Uuid
  updatedById      String?   @db.Uuid
  company          Company   @relation(fields: [companyId], references: [id])
  invoice          Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([invoiceId])
  @@index([sortOrder])
}

model PaymentReceipt {
  id              String              @id @default(uuid()) @db.Uuid
  companyId       String              @db.Uuid
  clientId        String              @db.Uuid
  receiptNumber   String
  receiptDate     DateTime
  amount          Decimal             @db.Decimal(12, 2)
  paymentMode     PaymentMode?
  referenceNumber String?
  notes           String?
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?
  createdById     String?             @db.Uuid
  updatedById     String?             @db.Uuid
  company         Company             @relation(fields: [companyId], references: [id])
  client          Client              @relation(fields: [clientId], references: [id])
  allocations     ReceiptAllocation[]

  @@unique([companyId, receiptNumber])
  @@index([companyId])
  @@index([clientId])
  @@index([receiptDate])
}

model ReceiptAllocation {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String         @db.Uuid
  receiptId   String         @db.Uuid
  invoiceId   String         @db.Uuid
  amount      Decimal        @db.Decimal(12, 2)
  allocatedAt DateTime       @default(now())
  createdAt   DateTime       @default(now())
  createdById String?        @db.Uuid
  company     Company        @relation(fields: [companyId], references: [id])
  receipt     PaymentReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoice     Invoice        @relation(fields: [invoiceId], references: [id])

  @@index([companyId])
  @@index([receiptId])
  @@index([invoiceId])
}

model CreditNote {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @db.Uuid
  clientId         String?   @db.Uuid
  invoiceId        String?   @db.Uuid
  creditNoteNumber String
  amount           Decimal   @db.Decimal(12, 2)
  reason           String?
  metadata         Json?
  noteDate         DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  createdById      String?   @db.Uuid
  updatedById      String?   @db.Uuid
  company          Company   @relation(fields: [companyId], references: [id])
  client           Client?   @relation(fields: [clientId], references: [id])
  invoice          Invoice?  @relation(fields: [invoiceId], references: [id])

  @@unique([companyId, creditNoteNumber])
  @@index([companyId])
  @@index([clientId])
  @@index([invoiceId])
}

model DebitNote {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid
  clientId        String?   @db.Uuid
  invoiceId       String?   @db.Uuid
  debitNoteNumber String
  amount          Decimal   @db.Decimal(12, 2)
  reason          String?
  metadata        Json?
  noteDate        DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdById     String?   @db.Uuid
  updatedById     String?   @db.Uuid
  company         Company   @relation(fields: [companyId], references: [id])
  client          Client?   @relation(fields: [clientId], references: [id])
  invoice         Invoice?  @relation(fields: [invoiceId], references: [id])

  @@unique([companyId, debitNoteNumber])
  @@index([companyId])
  @@index([clientId])
  @@index([invoiceId])
