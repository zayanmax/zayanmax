model ApprovalWorkflowDefinition {
  id          String                 @id @default(uuid()) @db.Uuid
  companyId   String                 @db.Uuid
  key         String
  name        String
  description String?
  module      String?
  entityType  ApprovalEntityType
  isDefault   Boolean                @default(false)
  status      RecordStatus           @default(ACTIVE)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  deletedAt   DateTime?
  createdById String?                @db.Uuid
  updatedById String?                @db.Uuid
  company     Company                @relation(fields: [companyId], references: [id])
  steps       ApprovalWorkflowStep[]
  requests    ApprovalRequest[]

  @@unique([companyId, key])
  @@index([companyId])
  @@index([entityType])
  @@index([status])
  @@index([createdAt])
}

model ApprovalWorkflowStep {
  id                   String                     @id @default(uuid()) @db.Uuid
  companyId            String                     @db.Uuid
  workflowDefinitionId String                     @db.Uuid
  stepOrder            Int
  name                 String
  approverType         ApprovalStepApproverType
  approverUserId       String?                    @db.Uuid
  approverEmployeeId   String?                    @db.Uuid
  approverRoleId       String?                    @db.Uuid
  approverDepartmentId String?                    @db.Uuid
  isRequired           Boolean                    @default(true)
  delegationAllowed    Boolean                    @default(true)
  escalationAfterHours Int?
  escalationMetadata   Json?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  deletedAt            DateTime?
  createdById          String?                    @db.Uuid
  updatedById          String?                    @db.Uuid
  company              Company                    @relation(fields: [companyId], references: [id])
  workflowDefinition   ApprovalWorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  approverUser         User?                      @relation("ApprovalWorkflowStepApproverUser", fields: [approverUserId], references: [id])
  approverEmployee     Employee?                  @relation("ApprovalWorkflowStepApproverEmployee", fields: [approverEmployeeId], references: [id])
  approverRole         Role?                      @relation("ApprovalWorkflowStepApproverRole", fields: [approverRoleId], references: [id])
  approverDepartment   Department?                @relation("ApprovalWorkflowStepApproverDepartment", fields: [approverDepartmentId], references: [id])
  stepInstances        ApprovalStepInstance[]

  @@unique([workflowDefinitionId, stepOrder])
  @@index([companyId])
  @@index([workflowDefinitionId])
  @@index([approverType])
  @@index([approverUserId])
  @@index([approverEmployeeId])
  @@index([approverRoleId])
  @@index([approverDepartmentId])
}

model ApprovalRequest {
  id                    String                      @id @default(uuid()) @db.Uuid
  companyId             String                      @db.Uuid
  workflowDefinitionId  String?                     @db.Uuid
  entityType            ApprovalEntityType
  entityId              String
  title                 String
  description           String?
  requestedByUserId     String?                     @db.Uuid
  requestedByEmployeeId String?                     @db.Uuid
  status                ApprovalRequestStatus       @default(DRAFT)
  currentStepOrder      Int                         @default(0)
  submittedAt           DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  metadata              Json?
  delegationMetadata    Json?
  escalationMetadata    Json?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  deletedAt             DateTime?
  createdById           String?                     @db.Uuid
  updatedById           String?                     @db.Uuid
  company               Company                     @relation(fields: [companyId], references: [id])
  workflowDefinition    ApprovalWorkflowDefinition? @relation(fields: [workflowDefinitionId], references: [id])
  requestedByUser       User?                       @relation("ApprovalRequestRequestedByUser", fields: [requestedByUserId], references: [id])
  requestedByEmployee   Employee?                   @relation("ApprovalRequestRequestedByEmployee", fields: [requestedByEmployeeId], references: [id])
  stepInstances         ApprovalStepInstance[]
  actions               ApprovalActionRecord[]

  @@index([companyId])
  @@index([workflowDefinitionId])
  @@index([entityType])
  @@index([entityId])
  @@index([requestedByUserId])
  @@index([requestedByEmployeeId])
  @@index([status])
  @@index([createdAt])
}

model ApprovalStepInstance {
  id                    String                   @id @default(uuid()) @db.Uuid
  companyId             String                   @db.Uuid
  requestId             String                   @db.Uuid
  workflowStepId        String?                  @db.Uuid
  stepOrder             Int
  name                  String
  approverType          ApprovalStepApproverType
  approverUserId        String?                  @db.Uuid
  approverEmployeeId    String?                  @db.Uuid
  approverRoleId        String?                  @db.Uuid
  approverDepartmentId  String?                  @db.Uuid
  status                ApprovalStepStatus       @default(PENDING)
  comment               String?
  decidedAt             DateTime?
  actedByUserId         String?                  @db.Uuid
  delegatedToUserId     String?                  @db.Uuid
  delegatedToEmployeeId String?                  @db.Uuid
  delegatedAt           DateTime?
  delegationReason      String?
  escalationDueAt       DateTime?
  escalationMetadata    Json?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  company               Company                  @relation(fields: [companyId], references: [id])
  request               ApprovalRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  workflowStep          ApprovalWorkflowStep?    @relation(fields: [workflowStepId], references: [id])
  approverUser          User?                    @relation("ApprovalStepInstanceApproverUser", fields: [approverUserId], references: [id])
  approverEmployee      Employee?                @relation("ApprovalStepInstanceApproverEmployee", fields: [approverEmployeeId], references: [id])
  approverRole          Role?                    @relation("ApprovalStepInstanceApproverRole", fields: [approverRoleId], references: [id])
  approverDepartment    Department?              @relation("ApprovalStepInstanceApproverDepartment", fields: [approverDepartmentId], references: [id])
  actedByUser           User?                    @relation("ApprovalStepInstanceActedByUser", fields: [actedByUserId], references: [id])
  delegatedToUser       User?                    @relation("ApprovalStepInstanceDelegatedToUser", fields: [delegatedToUserId], references: [id])
  delegatedToEmployee   Employee?                @relation("ApprovalStepInstanceDelegatedToEmployee", fields: [delegatedToEmployeeId], references: [id])
  actions               ApprovalActionRecord[]

  @@index([companyId])
  @@index([requestId])
  @@index([workflowStepId])
  @@index([stepOrder])
  @@index([approverUserId])
  @@index([approverEmployeeId])
  @@index([approverRoleId])
  @@index([approverDepartmentId])
  @@index([delegatedToUserId])
  @@index([status])
}

model ApprovalActionRecord {
  id              String                @id @default(uuid()) @db.Uuid
  companyId       String                @db.Uuid
  requestId       String                @db.Uuid
  stepInstanceId  String?               @db.Uuid
  action          ApprovalAction
  actorUserId     String?               @db.Uuid
  actorEmployeeId String?               @db.Uuid
  comment         String?
  metadata        Json?
  createdAt       DateTime              @default(now())
  company         Company               @relation(fields: [companyId], references: [id])
  request         ApprovalRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stepInstance    ApprovalStepInstance? @relation(fields: [stepInstanceId], references: [id])
  actorUser       User?                 @relation("ApprovalActionActorUser", fields: [actorUserId], references: [id])
  actorEmployee   Employee?             @relation("ApprovalActionActorEmployee", fields: [actorEmployeeId], references: [id])

  @@index([companyId])
  @@index([requestId])
  @@index([stepInstanceId])
  @@index([action])
  @@index([actorUserId])
  @@index([actorEmployeeId])
  @@index([createdAt])
}

model ReportExportRequest {
  id               String             @id @default(uuid()) @db.Uuid
  companyId        String             @db.Uuid
  requestedByUserId String?            @db.Uuid
  reportType       String
  requestedFilters Json?
  format           ReportExportFormat
  status           ReportExportStatus @default(PENDING)
  fileName         String?
  storageKey       String?
  mimeType         String?
  fileSize         Int?
  failureReason    String?
  requestedAt      DateTime           @default(now())
  processingAt     DateTime?
  completedAt      DateTime?
  failedAt         DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?
  company          Company            @relation(fields: [companyId], references: [id])
  requestedByUser  User?              @relation("ReportExportRequestRequestedByUser", fields: [requestedByUserId], references: [id])

  @@index([companyId])
  @@index([requestedByUserId])
  @@index([reportType])
  @@index([format])
  @@index([status])
  @@index([requestedAt])
  @@index([createdAt])
}
