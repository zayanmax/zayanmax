model Company {
  id                           String                        @id @default(uuid()) @db.Uuid
  name                         String
  legalName                    String?
  logoUrl                      String?
  email                        String?
  phone                        String?
  address                      String?
  timezone                     String                        @default("Asia/Kolkata")
  currency                     String                        @default("INR")
  status                       RecordStatus                  @default(ACTIVE)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  deletedAt                    DateTime?
  branches                     Branch[]
  departments                  Department[]
  designations                 Designation[]
  employees                    Employee[]
  users                        User[]
  roles                        Role[]
  auditLogs                    AuditLog[]
  clients                      Client[]
  projects                     Project[]
  tasks                        Task[]
  shifts                       Shift[]
  attendanceRecords            AttendanceRecord[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]
  leaveTypes                   LeaveType[]
  leaveBalances                LeaveBalance[]
  leaveRequests                LeaveRequest[]
  holidays                     Holiday[]
  salaryStructures             SalaryStructure[]
  salaryAssignments            EmployeeSalaryAssignment[]
  salaryAdvances               SalaryAdvance[]
  payrollPeriods               PayrollPeriod[]
  payrollRuns                  PayrollRun[]
  payrollLineItems             PayrollEmployeeLineItem[]
  payslips                     Payslip[]
  expenseCategories            ExpenseCategory[]
  expenseClaims                ExpenseClaim[]
  vendors                      Vendor[]
  vendorBills                  VendorBill[]
  vendorPayments               VendorPayment[]
  pettyCashAccounts            PettyCashAccount[]
  pettyCashTransactions        PettyCashTransaction[]
  purchaseRequests             PurchaseRequest[]
  purchaseOrders               PurchaseOrder[]
  goodsReceivedNotes           GoodsReceivedNote[]
  inventoryCategories          InventoryCategory[]
  inventoryItems               InventoryItem[]
  stockMovements               StockMovement[]
  assetCategories              AssetCategory[]
  assets                       Asset[]
  assetAssignments             AssetAssignment[]
  assetMaintenanceRecords      AssetMaintenanceRecord[]
  documentFolders              DocumentFolder[]
  documentCategories           DocumentCategory[]
  documentTags                 DocumentTag[]
  documentRecords              DocumentRecord[]
  documentVersions             DocumentVersion[]
  documentLinks                DocumentLink[]
  knowledgeBaseCategories      KnowledgeBaseCategory[]
  knowledgeBaseArticles        KnowledgeBaseArticle[]
  announcements                CompanyAnnouncement[]
  announcementAudiences        AnnouncementAudience[]
  announcementReadReceipts     AnnouncementReadReceipt[]
  notificationTypes            NotificationType[]
  internalNotifications        InternalNotification[]
  notificationDeliveries       NotificationDelivery[]
  notificationPreferences      NotificationPreference[]
  notificationTemplates        NotificationTemplate[]
  reminders                    ReminderRecord[]
  calendarEvents               CalendarEvent[]
  calendarEventAttendees       CalendarEventAttendee[]
  calendarResources            CalendarResource[]
  calendarResourceBookings     CalendarResourceBooking[]
  calendarEventReminders       CalendarEventReminder[]
  helpdeskTicketCategories     HelpdeskTicketCategory[]
  helpdeskTicketSubcategories  HelpdeskTicketSubcategory[]
  helpdeskTickets              HelpdeskTicket[]
  helpdeskTicketComments       HelpdeskTicketComment[]
  helpdeskTicketInternalNotes  HelpdeskTicketInternalNote[]
  helpdeskTicketAttachments    HelpdeskTicketAttachment[]
  performanceCycles            PerformanceCycle[]
  employeeGoals                EmployeeGoal[]
  goalProgressUpdates          GoalProgressUpdate[]
  kpiCategories                KpiCategory[]
  employeeKpiRecords           EmployeeKpiRecord[]
  reviewTemplates              ReviewTemplate[]
  reviewTemplateQuestions      ReviewTemplateQuestion[]
  employeeReviews              EmployeeReview[]
  reviewResponses              ReviewResponse[]
  feedbackRecords              FeedbackRecord[]
  oneOnOneMeetingNotes         OneOnOneMeetingNote[]
  promotionRecommendations     PromotionRecommendation[]
  jobOpenings                  JobOpening[]
  candidateProfiles            CandidateProfile[]
  candidatePipelineStages      CandidatePipelineStage[]
  candidateApplications        CandidateApplication[]
  interviewRounds              InterviewRound[]
  interviewFeedback            InterviewFeedback[]
  offerLetters                 OfferLetter[]
  onboardingChecklists         OnboardingChecklist[]
  onboardingChecklistItems     OnboardingChecklistItem[]
  leadSources                  LeadSource[]
  leadStages                   LeadStage[]
  salesLeads                   SalesLead[]
  leadActivities               LeadActivity[]
  leadNotes                    LeadNote[]
  opportunityStages            OpportunityStage[]
  salesOpportunities           SalesOpportunity[]
  quotations                   Quotation[]
  quotationItems               QuotationItem[]
  quotationVersions            QuotationVersion[]
  invoiceSeries                InvoiceSeries[]
  invoices                     Invoice[]
  invoiceItems                 InvoiceItem[]
  paymentReceipts              PaymentReceipt[]
  receiptAllocations           ReceiptAllocation[]
  creditNotes                  CreditNote[]
  debitNotes                   DebitNote[]
  approvalWorkflowDefinitions  ApprovalWorkflowDefinition[]
  approvalWorkflowSteps        ApprovalWorkflowStep[]
  approvalRequests             ApprovalRequest[]
  approvalStepInstances        ApprovalStepInstance[]
  approvalActions              ApprovalActionRecord[]
  reportExportRequests         ReportExportRequest[]

  @@index([status])
  @@index([createdAt])
}

model Branch {
  id                    String                 @id @default(uuid()) @db.Uuid
  companyId             String                 @db.Uuid
  name                  String
  address               String?
  phone                 String?
  status                RecordStatus           @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  company               Company                @relation(fields: [companyId], references: [id])
  employees             Employee[]
  announcementAudiences AnnouncementAudience[]
  jobOpenings           JobOpening[]

  @@index([companyId])
  @@index([status])
}

model Department {
  id                    String                   @id @default(uuid()) @db.Uuid
  companyId             String                   @db.Uuid
  name                  String
  description           String?
  status                RecordStatus             @default(ACTIVE)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  deletedAt             DateTime?
  company               Company                  @relation(fields: [companyId], references: [id])
  employees             Employee[]
  documentFolders       DocumentFolder[]
  documentRecords       DocumentRecord[]
  announcementAudiences AnnouncementAudience[]
  helpdeskCategories    HelpdeskTicketCategory[]
  helpdeskTickets       HelpdeskTicket[]
  jobOpenings           JobOpening[]
  approvalWorkflowSteps ApprovalWorkflowStep[]   @relation("ApprovalWorkflowStepApproverDepartment")
  approvalStepInstances ApprovalStepInstance[]   @relation("ApprovalStepInstanceApproverDepartment")

  @@unique([companyId, name])
  @@index([companyId])
  @@index([status])
}

model Designation {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  name        String
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  company     Company      @relation(fields: [companyId], references: [id])
  employees   Employee[]
  jobOpenings JobOpening[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([status])
}

model Employee {
  id                             String                        @id @default(uuid()) @db.Uuid
  companyId                      String                        @db.Uuid
  branchId                       String?                       @db.Uuid
  employeeCode                   String
  firstName                      String
  lastName                       String
  email                          String
  phone                          String?
  departmentId                   String?                       @db.Uuid
  designationId                  String?                       @db.Uuid
  reportingManagerId             String?                       @db.Uuid
  joiningDate                    DateTime
  employmentType                 EmploymentType                @default(FULL_TIME)
  status                         RecordStatus                  @default(ACTIVE)
  createdAt                      DateTime                      @default(now())
  updatedAt                      DateTime                      @updatedAt
  deletedAt                      DateTime?
  createdById                    String?                       @db.Uuid
  updatedById                    String?                       @db.Uuid
  company                        Company                       @relation(fields: [companyId], references: [id])
  branch                         Branch?                       @relation(fields: [branchId], references: [id])
  department                     Department?                   @relation(fields: [departmentId], references: [id])
  designation                    Designation?                  @relation(fields: [designationId], references: [id])
  reportingManager               Employee?                     @relation("EmployeeManager", fields: [reportingManagerId], references: [id])
  directReports                  Employee[]                    @relation("EmployeeManager")
  user                           User?
  projectMemberships             ProjectMember[]               @relation("ProjectMemberEmployee")
  taskAssignments                TaskAssignee[]                @relation("TaskAssigneeEmployee")
  attendanceRecords              AttendanceRecord[]
  attendanceCorrectionRequests   AttendanceCorrectionRequest[]
  leaveBalances                  LeaveBalance[]
  leaveRequests                  LeaveRequest[]
  salaryAssignments              EmployeeSalaryAssignment[]
  salaryAdvances                 SalaryAdvance[]
  payrollLineItems               PayrollEmployeeLineItem[]
  payslips                       Payslip[]
  expenseClaims                  ExpenseClaim[]
  requestedPurchases             PurchaseRequest[]
  assetAssignments               AssetAssignment[]
  assignedAssets                 Asset[]                       @relation("AssetAssignedEmployee")
  documentLinks                  DocumentLink[]
  announcementAudiences          AnnouncementAudience[]
  calendarEvents                 CalendarEvent[]
  calendarEventAttendees         CalendarEventAttendee[]
  requestedHelpdeskTickets       HelpdeskTicket[]              @relation("HelpdeskRequesterEmployee")
  assignedHelpdeskTickets        HelpdeskTicket[]              @relation("HelpdeskAssignedEmployee")
  helpdeskTicketComments         HelpdeskTicketComment[]       @relation("HelpdeskCommentAuthorEmployee")
  helpdeskTicketInternalNotes    HelpdeskTicketInternalNote[]  @relation("HelpdeskNoteAuthorEmployee")
  employeeGoals                  EmployeeGoal[]
  goalProgressUpdates            GoalProgressUpdate[]
  employeeKpiRecords             EmployeeKpiRecord[]
  employeeReviews                EmployeeReview[]              @relation("ReviewEmployee")
  managedEmployeeReviews         EmployeeReview[]              @relation("ReviewManagerEmployee")
  feedbackReceived               FeedbackRecord[]              @relation("FeedbackEmployee")
  feedbackGiven                  FeedbackRecord[]              @relation("FeedbackByEmployee")
  oneOnOneMeetingNotes           OneOnOneMeetingNote[]         @relation("OneOnOneEmployee")
  managedOneOnOneMeetingNotes    OneOnOneMeetingNote[]         @relation("OneOnOneManagerEmployee")
  promotionRecommendations       PromotionRecommendation[]     @relation("PromotionEmployee")
  promotionRecommendationsGiven  PromotionRecommendation[]     @relation("PromotionByEmployee")
  convertedCandidateApplications CandidateApplication[]        @relation("ConvertedCandidateEmployee")
  interviewRounds                InterviewRound[]              @relation("InterviewRoundInterviewer")
  interviewFeedback              InterviewFeedback[]           @relation("InterviewFeedbackEmployee")
  onboardingChecklists           OnboardingChecklist[]         @relation("OnboardingEmployee")
  assignedSalesLeads             SalesLead[]                   @relation("SalesLeadAssignedEmployee")
  assignedSalesOpportunities     SalesOpportunity[]            @relation("SalesOpportunityAssignedEmployee")
  approvalWorkflowSteps          ApprovalWorkflowStep[]        @relation("ApprovalWorkflowStepApproverEmployee")
  approvalRequests               ApprovalRequest[]             @relation("ApprovalRequestRequestedByEmployee")
  approvalStepInstances          ApprovalStepInstance[]        @relation("ApprovalStepInstanceApproverEmployee")
  delegatedApprovalStepInstances ApprovalStepInstance[]        @relation("ApprovalStepInstanceDelegatedToEmployee")
  approvalActions                ApprovalActionRecord[]        @relation("ApprovalActionActorEmployee")

  @@unique([companyId, employeeCode])
  @@unique([companyId, email])
  @@index([companyId])
  @@index([branchId])
  @@index([departmentId])
  @@index([designationId])
  @@index([employeeCode])
  @@index([email])
  @@index([status])
}

model User {
  id                          String                       @id @default(uuid()) @db.Uuid
  companyId                   String                       @db.Uuid
  employeeId                  String?                      @unique @db.Uuid
  email                       String                       @unique
  passwordHash                String
  refreshTokenHash            String?
  isEmailVerified             Boolean                      @default(false)
  status                      RecordStatus                 @default(ACTIVE)
  lastLoginAt                 DateTime?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  deletedAt                   DateTime?
  company                     Company                      @relation(fields: [companyId], references: [id])
  employee                    Employee?                    @relation(fields: [employeeId], references: [id])
  roles                       UserRole[]
  ownedClients                Client[]                     @relation("ClientOwner")
  projectMemberships          ProjectMember[]              @relation("ProjectMemberUser")
  taskAssignments             TaskAssignee[]               @relation("TaskAssigneeUser")
  ownedDocumentFolders        DocumentFolder[]             @relation("DocumentFolderOwner")
  ownedDocuments              DocumentRecord[]             @relation("DocumentOwner")
  authoredKnowledgeArticles   KnowledgeBaseArticle[]       @relation("KnowledgeArticleAuthor")
  authoredAnnouncements       CompanyAnnouncement[]        @relation("AnnouncementAuthor")
  announcementReadReceipts    AnnouncementReadReceipt[]
  internalNotifications       InternalNotification[]       @relation("NotificationRecipient")
  notificationPreferences     NotificationPreference[]
  reminderRecords             ReminderRecord[]             @relation("ReminderRecipient")
  createdCalendarEvents       CalendarEvent[]              @relation("CalendarEventCreator")
  calendarEventAttendees      CalendarEventAttendee[]      @relation("CalendarEventAttendeeUser")
  requestedHelpdeskTickets    HelpdeskTicket[]             @relation("HelpdeskRequesterUser")
  assignedHelpdeskTickets     HelpdeskTicket[]             @relation("HelpdeskAssignedUser")
  helpdeskTicketComments      HelpdeskTicketComment[]      @relation("HelpdeskCommentAuthorUser")
  helpdeskTicketInternalNotes HelpdeskTicketInternalNote[] @relation("HelpdeskNoteAuthorUser")
  assignedSalesLeads          SalesLead[]                  @relation("SalesLeadAssignedUser")
  assignedSalesOpportunities  SalesOpportunity[]           @relation("SalesOpportunityAssignedUser")
  approvalWorkflowSteps       ApprovalWorkflowStep[]       @relation("ApprovalWorkflowStepApproverUser")
  approvalRequests            ApprovalRequest[]            @relation("ApprovalRequestRequestedByUser")
  approvalStepInstances       ApprovalStepInstance[]       @relation("ApprovalStepInstanceApproverUser")
  actedApprovalStepInstances  ApprovalStepInstance[]       @relation("ApprovalStepInstanceActedByUser")
  delegatedApprovalSteps      ApprovalStepInstance[]       @relation("ApprovalStepInstanceDelegatedToUser")
  approvalActions             ApprovalActionRecord[]       @relation("ApprovalActionActorUser")
  reportExportRequests        ReportExportRequest[]        @relation("ReportExportRequestRequestedByUser")

  @@index([companyId])
  @@index([email])
  @@index([status])
}

model Role {
  id                    String                 @id @default(uuid()) @db.Uuid
  companyId             String                 @db.Uuid
  name                  String
  description           String?
  isSystemRole          Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  company               Company                @relation(fields: [companyId], references: [id])
  permissions           RolePermission[]
  users                 UserRole[]
  announcementAudiences AnnouncementAudience[]
  approvalWorkflowSteps ApprovalWorkflowStep[] @relation("ApprovalWorkflowStepApproverRole")
  approvalStepInstances ApprovalStepInstance[] @relation("ApprovalStepInstanceApproverRole")

  @@unique([companyId, name])
  @@index([companyId])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  module      String
  action      String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String?  @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  company    Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([actorId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model Client {
  id              String             @id @default(uuid()) @db.Uuid
  companyId       String             @db.Uuid
  type            ClientType
  name            String
  email           String?
  phone           String?
  website         String?
  industry        String?
  companySize     String?
  taxNumber       String?
  billingAddress  String?
  status          ClientStatus       @default(ACTIVE)
  ownerId         String?            @db.Uuid
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  createdById     String?            @db.Uuid
  updatedById     String?            @db.Uuid
  company         Company            @relation(fields: [companyId], references: [id])
  owner           User?              @relation("ClientOwner", fields: [ownerId], references: [id])
  contacts        ClientContact[]
  activities      ClientActivity[]
  notes           ClientNote[]
  documents       ClientDocument[]
  projects        Project[]
  documentLinks   DocumentLink[]
  calendarEvents  CalendarEvent[]
  convertedLeads  SalesLead[]        @relation("LeadConvertedClient")
  opportunities   SalesOpportunity[]
  quotations      Quotation[]
  invoices        Invoice[]
  paymentReceipts PaymentReceipt[]
  creditNotes     CreditNote[]
  debitNotes      DebitNote[]

  @@index([companyId])
  @@index([ownerId])
  @@index([status])
  @@index([type])
  @@index([name])
  @@index([email])
  @@index([phone])
  @@index([createdAt])
}

model Project {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @db.Uuid
  clientId       String?         @db.Uuid
  name           String
